  "components": {
    "schemas": {
      "AccountState": {
        "properties": {
          "cash_cents": {
            "type": "integer",
            "title": "Cash Cents"
          },
          "frozen_cash_cents": {
            "type": "integer",
            "title": "Frozen Cash Cents"
          },
          "available_cash_cents": {
            "type": "integer",
            "title": "Available Cash Cents"
          },
          "positions": {
            "additionalProperties": true,
            "type": "object",
            "title": "Positions"
          },
          "fees_cents": {
            "type": "integer",
            "title": "Fees Cents"
          },
          "equity_cents": {
            "type": "integer",
            "title": "Equity Cents"
          },
          "incremental_pnl_cents": {
            "type": "integer",
            "title": "Incremental Pnl Cents"
          }
        },
        "type": "object",
        "required": [
          "cash_cents",
          "frozen_cash_cents",
          "available_cash_cents",
          "positions",
          "fees_cents",
          "equity_cents",
          "incremental_pnl_cents"
        ],
        "title": "AccountState"
      },
      "AdvanceRequest": {
        "properties": {
          "to_ms": {
            "type": "integer",
            "title": "To Ms"
          }
        },
        "type": "object",
        "required": [
          "to_ms"
        ],
        "title": "AdvanceRequest"
      },
      "ExecutionReport": {
        "properties": {
          "seq": {
            "type": "integer",
            "title": "Seq"
          },
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "qty": {
            "type": "integer",
            "title": "Qty"
          },
          "price": {
            "type": "integer",
            "title": "Price"
          },
          "execution_time": {
            "type": "integer",
            "title": "Execution Time"
          },
          "delivery_time": {
            "type": "integer",
            "title": "Delivery Time"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "seq",
          "order_id",
          "status",
          "qty",
          "price",
          "execution_time",
          "delivery_time"
        ],
        "title": "ExecutionReport"
      },
      "ExperimentConfig": {
        "properties": {
          "device": {
            "type": "string",
            "enum": [
              "auto",
              "mps",
              "cuda",
              "cpu"
            ],
            "title": "Device",
            "default": "auto"
          },
          "seed": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Seed",
            "default": 20260923
          },
          "parent_yuan": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Parent Yuan",
            "default": 50000
          },
          "horizons_s": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Horizons S",
            "default": [
              1,
              5,
              30,
              60
            ]
          },
          "deadline_s": {
            "type": "integer",
            "title": "Deadline S",
            "default": 60
          }
        },
        "type": "object",
        "title": "ExperimentConfig"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MarketEvent": {
        "properties": {
          "logical_ms": {
            "type": "integer",
            "title": "Logical Ms"
          },
          "biz_index": {
            "type": "integer",
            "title": "Biz Index"
          },
          "channel": {
            "type": "integer",
            "title": "Channel"
          },
          "kind": {
            "type": "string",
            "enum": [
